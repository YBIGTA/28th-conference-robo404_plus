<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="urban_clutter">

    <!-- Cool dim lighting, like an indoor/covered area -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.60 0.58 0.70 1</diffuse>
      <specular>0.10 0.10 0.12 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0.2 -0.5 -0.8</direction>
    </light>

    <!-- Brick ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Bricks</name>
          </script></material>
        </visual>
      </link>
    </model>

    <!-- Track: 5.5m straight, moderate angle, 5m straight -->
    <model name="lane_segment_1">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>5.5 0.10 0.001</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Yellow</name>
          </script></material>
        </visual>
      </link>
      <pose>2.75 0.0 0.0005 0 0 0</pose>
    </model>

    <model name="lane_segment_2">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.06 0.10 0.001</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Yellow</name>
          </script></material>
        </visual>
      </link>
      <pose>6.5 0.65 0.0005 0 0 0.57</pose>
    </model>

    <model name="lane_segment_3">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>5.0 0.10 0.001</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Yellow</name>
          </script></material>
        </visual>
      </link>
      <pose>10.2 1.3 0.0005 0 0 0</pose>
    </model>

    <!-- Realistic stop_light on pole -->
    <model name="traffic_light_pole">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.035</radius><length>0.7</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.035</radius><length>0.7</length></cylinder></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script></material>
        </visual>
      </link>
      <pose>5.5 -0.6 0.35 0 0 0</pose>
    </model>

    <include>
      <uri>model://stop_light</uri>
      <name>traffic_light</name>
      <pose>5.5 -0.6 1.1 0 0 1.5708</pose>
    </include>

    <!-- Obstacle: purple box -->
    <model name="obstacle_box">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.45 0.55 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.45 0.55 0.6</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Purple</name>
          </script></material>
        </visual>
      </link>
      <pose>11.8 1.3 0.3 0 0 0.3</pose>
    </model>

    <!-- Urban clutter: walls, barriers, objects -->
    <include>
      <uri>model://grey_wall</uri>
      <name>wall_1</name>
      <pose>0.0 -2.5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://grey_wall</uri>
      <name>wall_2</name>
      <pose>7.0 3.5 0 0 0 0.1</pose>
    </include>
    <include>
      <uri>model://brick_box_3x1x3</uri>
      <name>brick_1</name>
      <pose>3.0 2.0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://postbox</uri>
      <name>postbox_1</name>
      <pose>8.0 -1.8 0 0 0 0.5</pose>
    </include>
    <include>
      <uri>model://construction_cone</uri>
      <name>cone_1</name>
      <pose>9.5 0.3 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://drc_practice_orange_jersey_barrier</uri>
      <name>orange_barrier</name>
      <pose>13.5 2.8 0 0 0 0.8</pose>
    </include>

  </world>
</sdf>
