<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="dusk_scene">

    <!-- Low orange dusk sun, strong shadows -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.75 0.50 0.30 1</diffuse>
      <specular>0.15 0.10 0.05 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.8 0.0 -0.4</direction>
    </light>

    <!-- Dark ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/DarkGrey</name>
          </script></material>
        </visual>
      </link>
    </model>

    <!-- Track: 8m straight, gentle angle, 4.5m straight -->
    <model name="lane_segment_1">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>8.0 0.10 0.001</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/White</name>
          </script></material>
        </visual>
      </link>
      <pose>4.0 0.0 0.0005 0 0 0</pose>
    </model>

    <model name="lane_segment_2">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.24 0.10 0.001</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/White</name>
          </script></material>
        </visual>
      </link>
      <pose>9.0 0.5 0.0005 0 0 0.46</pose>
    </model>

    <model name="lane_segment_3">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4.5 0.10 0.001</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/White</name>
          </script></material>
        </visual>
      </link>
      <pose>12.25 1.0 0.0005 0 0 0</pose>
    </model>

    <!-- Custom traffic light (close to track, low) -->
    <model name="traffic_light">
      <static>true</static>
      <link name="pole">
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.4</length></cylinder></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script></material>
        </visual>
        <pose>0 0 0.2 0 0 0</pose>
      </link>
      <link name="head">
        <collision name="collision">
          <geometry><box><size>0.20 0.20 0.65</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.20 0.20 0.65</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Black</name>
          </script></material>
        </visual>
        <pose>0 0 0.725 0 0 0</pose>
      </link>
      <link name="red_light">
        <visual name="visual">
          <geometry><cylinder><radius>0.06</radius><length>0.02</length></cylinder></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/RedGlow</name>
          </script></material>
        </visual>
        <pose>0 0.101 0.90 1.5708 0 0</pose>
      </link>
      <link name="yellow_light">
        <visual name="visual">
          <geometry><cylinder><radius>0.06</radius><length>0.02</length></cylinder></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/YellowGlow</name>
          </script></material>
        </visual>
        <pose>0 0.101 0.72 1.5708 0 0</pose>
      </link>
      <link name="green_light">
        <visual name="visual">
          <geometry><cylinder><radius>0.06</radius><length>0.02</length></cylinder></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/GreenGlow</name>
          </script></material>
        </visual>
        <pose>0 0.101 0.54 1.5708 0 0</pose>
      </link>
      <pose>8.0 -0.5 0.0 0 0 1.5708</pose>
    </model>

    <!-- Obstacle: blue box -->
    <model name="obstacle_box">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.35 0.50 0.45</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.35 0.50 0.45</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Blue</name>
          </script></material>
        </visual>
      </link>
      <pose>13.0 1.0 0.225 0 0 0.5</pose>
    </model>

    <!-- Dusk scenery: lamp posts, person, vehicle -->
    <include>
      <uri>model://lamp_post</uri>
      <name>lamp_1</name>
      <pose>3.0 -2.0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://lamp_post</uri>
      <name>lamp_2</name>
      <pose>11.0 -1.5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://person_standing</uri>
      <name>person_1</name>
      <pose>6.0 2.0 0 0 0 -0.3</pose>
    </include>
    <include>
      <uri>model://pine_tree</uri>
      <name>tree_1</name>
      <pose>1.0 2.5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://suv</uri>
      <name>parked_car</name>
      <pose>14.5 -2.0 0 0 0 1.2</pose>
    </include>

  </world>
</sdf>
