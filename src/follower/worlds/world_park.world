<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="park_scene">

    <!-- Warm afternoon sun, casting long shadows -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.90 0.82 0.65 1</diffuse>
      <specular>0.25 0.22 0.15 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.7 0.4 -0.55</direction>
    </light>

    <!-- Grass ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grass</name>
          </script></material>
        </visual>
      </link>
    </model>

    <!-- Track: 6m straight, gentle angle, 7m straight (wider track for grass contrast) -->
    <model name="lane_segment_1">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>6.0 0.10 0.001</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/FlatBlack</name>
          </script></material>
        </visual>
      </link>
      <pose>3.0 0.0 0.0005 0 0 0</pose>
    </model>

    <model name="lane_segment_2">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.8 0.10 0.001</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/FlatBlack</name>
          </script></material>
        </visual>
      </link>
      <pose>7.0 0.4 0.0005 0 0 0.42</pose>
    </model>

    <model name="lane_segment_3">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>7.0 0.10 0.001</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/FlatBlack</name>
          </script></material>
        </visual>
      </link>
      <pose>11.5 0.8 0.0005 0 0 0</pose>
    </model>

    <!-- Custom traffic light (shorter, park-style) -->
    <model name="traffic_light">
      <static>true</static>
      <link name="pole">
        <collision name="collision">
          <geometry><cylinder><radius>0.04</radius><length>0.35</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.04</radius><length>0.35</length></cylinder></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/DarkGrey</name>
          </script></material>
        </visual>
        <pose>0 0 0.175 0 0 0</pose>
      </link>
      <link name="head">
        <collision name="collision">
          <geometry><box><size>0.18 0.18 0.60</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.18 0.18 0.60</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/FlatBlack</name>
          </script></material>
        </visual>
        <pose>0 0 0.65 0 0 0</pose>
      </link>
      <link name="red_light">
        <visual name="visual">
          <geometry><cylinder><radius>0.055</radius><length>0.02</length></cylinder></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Red</name>
          </script></material>
        </visual>
        <pose>0 0.091 0.80 1.5708 0 0</pose>
      </link>
      <link name="yellow_light">
        <visual name="visual">
          <geometry><cylinder><radius>0.055</radius><length>0.02</length></cylinder></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Yellow</name>
          </script></material>
        </visual>
        <pose>0 0.091 0.65 1.5708 0 0</pose>
      </link>
      <link name="green_light">
        <visual name="visual">
          <geometry><cylinder><radius>0.055</radius><length>0.02</length></cylinder></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Green</name>
          </script></material>
        </visual>
        <pose>0 0.091 0.50 1.5708 0 0</pose>
      </link>
      <pose>6.0 -1.0 0.0 0 0 1.5708</pose>
    </model>

    <!-- Obstacle: green box blending with grass (hard case!) -->
    <model name="obstacle_box">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.35</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.35</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Green</name>
          </script></material>
        </visual>
      </link>
      <pose>13.5 0.8 0.175 0 0 0</pose>
    </model>

    <!-- Park scenery -->
    <include>
      <uri>model://oak_tree</uri>
      <name>tree_1</name>
      <pose>2.0 3.0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://pine_tree</uri>
      <name>tree_2</name>
      <pose>9.0 -3.0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://oak_tree</uri>
      <name>tree_3</name>
      <pose>14.0 3.5 0 0 0 0.5</pose>
    </include>
    <include>
      <uri>model://fire_hydrant</uri>
      <name>hydrant_1</name>
      <pose>4.0 -1.8 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://postbox</uri>
      <name>postbox_1</name>
      <pose>10.5 -1.5 0 0 0 0.2</pose>
    </include>

  </world>
</sdf>
