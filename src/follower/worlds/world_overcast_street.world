<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="overcast_street">

    <!-- Dim, cool-toned overcast lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.55 0.55 0.62 1</diffuse>
      <specular>0.08 0.08 0.08 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.1 -0.3 -0.95</direction>
    </light>

    <!-- Road-textured ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script></material>
        </visual>
      </link>
    </model>

    <!-- Track: 5m straight, sharp turn, 6m straight -->
    <model name="lane_segment_1">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>5.0 0.12 0.001</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/White</name>
          </script></material>
        </visual>
      </link>
      <pose>2.5 0.0 0.0005 0 0 0</pose>
    </model>

    <model name="lane_segment_2">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.83 0.12 0.001</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/White</name>
          </script></material>
        </visual>
      </link>
      <pose>6.0 1.0 0.0005 0 0 0.7854</pose>
    </model>

    <model name="lane_segment_3">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>6.0 0.12 0.001</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/White</name>
          </script></material>
        </visual>
      </link>
      <pose>10.0 2.0 0.0005 0 0 0</pose>
    </model>

    <!-- Realistic stop_light from Gazebo model DB -->
    <model name="traffic_light_pole">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.03</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.03</radius><length>0.9</length></cylinder></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/DarkGrey</name>
          </script></material>
        </visual>
      </link>
      <pose>5.0 -1.0 0.45 0 0 0</pose>
    </model>

    <include>
      <uri>model://stop_light</uri>
      <name>traffic_light</name>
      <pose>5.0 -1.0 1.3 0 0 1.5708</pose>
    </include>

    <!-- Obstacle: orange barrier on segment 3 -->
    <model name="obstacle_box">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.3 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.3 0.5</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Orange</name>
          </script></material>
        </visual>
      </link>
      <pose>11.5 2.0 0.25 0 0 0</pose>
    </model>

    <!-- Street clutter -->
    <include>
      <uri>model://jersey_barrier</uri>
      <name>barrier_1</name>
      <pose>3.0 -1.5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://jersey_barrier</uri>
      <name>barrier_2</name>
      <pose>8.5 3.2 0 0 0 0.4</pose>
    </include>
    <include>
      <uri>model://stop_sign</uri>
      <name>sign_1</name>
      <pose>9.0 -0.5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://fire_hydrant</uri>
      <name>hydrant_1</name>
      <pose>12.5 0.5 0 0 0 0</pose>
    </include>

  </world>
</sdf>
