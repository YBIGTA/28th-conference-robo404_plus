<?xml version="1.0"?>
<!--
  robo404+ : 4WD acrylic smart-car chassis.

  Real-world reference (standard yellow TT-motor 4WD kit):
    - acrylic base plate : ~0.22 m (L) x 0.145 m (W)
    - wheels             : ~0.066 m diameter, ~0.026 m wide
    - 4 wheels, no steering  -> modelled as skid-steer / differential drive
    - forward-facing camera  -> for the line-following / follower node

  Frames:
    base_footprint -> base_link -> {4 wheels, camera}
-->
<robot name="robo404" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find robo_description)/urdf/macros.xacro" />

  <!-- ======================= Parameters ======================= -->
  <xacro:property name="chassis_length" value="0.22"  />
  <xacro:property name="chassis_width"  value="0.145" />
  <xacro:property name="chassis_height" value="0.045" />
  <xacro:property name="chassis_mass"   value="0.6"   />

  <xacro:property name="wheel_radius"   value="0.033" />
  <xacro:property name="wheel_width"    value="0.026" />
  <xacro:property name="wheel_mass"     value="0.05"  />

  <!-- wheel placement relative to base_link (centre of chassis, at axle height) -->
  <xacro:property name="wheel_xoff" value="0.075"  />  <!-- half wheelbase     -->
  <xacro:property name="wheel_yoff" value="0.0855" />  <!-- half track width   -->
  <xacro:property name="wheel_separation" value="${2*wheel_yoff}" />

  <!-- camera placement -->
  <xacro:property name="cam_x" value="${chassis_length/2 - 0.01}" />
  <xacro:property name="cam_z" value="0.06"  />
  <xacro:property name="cam_pitch" value="0.5" />   <!-- look slightly down for the line -->

  <!-- ======================= Materials ======================= -->
  <material name="acrylic"><color rgba="0.85 0.92 1.0 0.4"/></material>
  <material name="wheel_yellow"><color rgba="0.95 0.78 0.0 1.0"/></material>
  <material name="tyre_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="cam_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>

  <!-- ======================= Base ======================= -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="acrylic"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}"
                         y="${chassis_width}" z="${chassis_height}"/>
    </inertial>
  </link>

  <!-- ======================= Wheel macro ======================= -->
  <!-- x_reflect:  +1 front, -1 rear     y_reflect: +1 left, -1 right -->
  <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="tyre_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <xacro:wheel_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel"/>
      <origin xyz="${x_reflect*wheel_xoff} ${y_reflect*wheel_yoff} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="front_left"  x_reflect="1"  y_reflect="1"/>
  <xacro:wheel prefix="front_right" x_reflect="1"  y_reflect="-1"/>
  <xacro:wheel prefix="rear_left"   x_reflect="-1" y_reflect="1"/>
  <xacro:wheel prefix="rear_right"  x_reflect="-1" y_reflect="-1"/>

  <!-- ======================= Camera ======================= -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.03 0.02"/></geometry>
      <material name="cam_grey"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.03 0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <xacro:box_inertia m="0.02" x="0.02" y="0.03" z="0.02"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${cam_x} 0 ${cam_z}" rpy="0 ${cam_pitch} 0"/>
  </joint>

  <!-- Optical frame: REP-103 camera convention (z forward, x right, y down) -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ======================= Gazebo plugins ======================= -->
  <xacro:include filename="$(find robo_description)/urdf/robo404.gazebo.xacro" />

</robot>
